# 构建产物
build/
build-*/
out/
cmake-build-*/

# CMake 缓存
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
!Makefile
compile_commands.json
.cache/

# 本地工具/记忆目录（不入库）
.cac/
.codegraph/
memory/

# Ninja
.ninja_deps
.ninja_log
*.ninja

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ICU 预下载缓存（开发者手工放入，不入库）
third_party/icu/download/*
!third_party/icu/download/.gitkeep

# 二进制输出
*.exe
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib

# 内存/性能分析输出（core dump，仅根目录，避免误匹配 src/private/core 等）
*.valgrind
*.asan
/core
/core.*
