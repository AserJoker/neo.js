# 统一换行为 LF，文本文件自动归一化
* text=auto eol=lf

# 显式声明源码文本类型
*.cpp   text eol=lf
*.cc    text eol=lf
*.h     text eol=lf
*.hpp   text eol=lf
*.c     text eol=lf
*.txt   text eol=lf
*.cmake text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.py    text eol=lf
*.ps1   text eol=crlf
*.sh    text eol=lf

# 二进制文件
*.png   binary
*.jpg   binary
*.pdf   binary
*.dat   binary
*.zip   binary
*.tgz   binary
*.gz    binary
